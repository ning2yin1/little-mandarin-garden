[
  {
    "id": "g001",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "是：〜です",
    "pattern": "主語＋是＋名詞",
    "explanation_ja": "人や物の正体・所属を表します。形容詞だけを述べるときには普通「是」を入れません。否定は「不是」です。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g002",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "不：習慣・意思の否定",
    "pattern": "主語＋不＋動詞／形容詞",
    "explanation_ja": "ふだんしないことや意思、性質を否定します。過去の出来事が起きなかった場合は普通「没」を使います。「不」は第四声の前では bú と発音します。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g003",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "有・没有：持つ／ある",
    "pattern": "主語＋有／没有＋名詞",
    "explanation_ja": "所有や存在を表します。「有」の否定は「没有」で、「不有」にはしません。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g004",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "吗：はい・いいえの質問",
    "pattern": "平叙文＋吗",
    "explanation_ja": "文末に「吗」を置いて質問にします。語順を英語のように入れ替える必要はありません。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g005",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "疑問詞：誰・何・どこ",
    "pattern": "知りたい部分を疑問詞にする",
    "explanation_ja": "「谁・什么・哪儿」などを、答えにあたる位置へ置きます。疑問詞がある文に普通「吗」は足しません。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g006",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "呢：相手に問い返す",
    "pattern": "名詞／代名詞＋呢",
    "explanation_ja": "前の話題を受けて「〜は？」とたずねます。場所を問う文脈では「〜はどこ？」にもなります。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g007",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "的：所有・修飾",
    "pattern": "修飾する語＋的＋名詞",
    "explanation_ja": "「私の本」「新しい服」のように、名詞の前の説明をつなぎます。親しい家族などでは「我妈妈」のように省くこともあります。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g008",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "形容詞述語・很",
    "pattern": "主語＋很＋形容詞",
    "explanation_ja": "中国語では形容詞がそのまま述語になります。「很」はここでは自然なつなぎとして働くこともあり、必ず強い「とても」ではありません。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g009",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "也・都：〜も／みんな",
    "pattern": "主語＋也／都＋述語",
    "explanation_ja": "「也」「都」は述語の前に置きます。「都」は前に出た複数の人や物がすべてそうだと表します。「也都」の順で併用できます。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g010",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "在：場所にいる／ある",
    "pattern": "人・物＋在＋場所",
    "explanation_ja": "「在」は存在する場所を示す動詞です。「机の上に本がある」のように物の存在を初めて紹介する文では「有」も使います。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g011",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "時間の位置",
    "pattern": "主語＋時間＋動詞",
    "explanation_ja": "時間は一般に動詞より前です。「明天我去学校」のように主語の前にも置けます。どちらも自然な語順です。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g012",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "数詞＋量詞",
    "pattern": "数＋量詞＋名詞",
    "explanation_ja": "物を数えるときは名詞に合う量詞を入れます。「个」は汎用、「本」は本、「杯」は飲み物、「只」は小動物などです。量詞の前の2は普通「两」です。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g013",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "想・要：希望と意志",
    "pattern": "主語＋想／要＋動詞",
    "explanation_ja": "「想」は〜したいという気持ち、「要」は欲しい・するつもりというはっきりした意志に使います。不要を伝える「不要」は文脈で禁止にもなります。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g014",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "会・能・可以",
    "pattern": "主語＋会／能／可以＋動詞",
    "explanation_ja": "「会」は身につけた技能、「能」は能力や状況的に可能なこと、「可以」は許可などです。日本語の「できる」を場面で使い分けます。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g015",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "和：名詞を並べる",
    "pattern": "名詞＋和＋名詞",
    "explanation_ja": "「和」は名詞同士を「〜と〜」とつなぎます。文と文を何でもつなぐ日本語の「そして」とは違います。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g016",
    "level": 1,
    "level_label": "HSK1目安",
    "title_ja": "太〜了：程度が強い",
    "pattern": "太＋形容詞＋了",
    "explanation_ja": "「とても〜」「〜すぎる」という強い気持ちを表します。ここの「了」は過去を示す印ではありません。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g017",
    "level": 2,
    "level_label": "HSK2目安",
    "title_ja": "在／正在：動作の進行",
    "pattern": "主語＋正在＋動詞",
    "explanation_ja": "今まさに行っている動作を表します。「在」「正在」が使え、文末に「呢」を添えることもあります。場所の「在」と区別しましょう。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g018",
    "level": 2,
    "level_label": "HSK2目安",
    "title_ja": "了：動作の完了",
    "pattern": "動詞＋了＋目的語",
    "explanation_ja": "出来事が実現したことを示します。単なる過去時制ではありません。否定は「没＋動詞」とし、完了の「了」を通常外します。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g019",
    "level": 2,
    "level_label": "HSK2目安",
    "title_ja": "没：まだしていない／しなかった",
    "pattern": "主語＋没＋動詞",
    "explanation_ja": "動作が実現していないことを表します。「不」は習慣や意思の否定です。「还没」は「まだ〜していない」です。",
    "prerequisites": [],
    "question_count": 10
  },
  {
    "id": "g020",
    "level": 2,
    "level_label": "HSK2目安",
    "title_ja": "文末の了：変化",
    "pattern": "新しい状態＋了",
    "explanation_ja": "前とは状況が変わったことを示します。「下雨了」は雨が降り始めた、「不喝了」はもう飲まないという変化です。",
