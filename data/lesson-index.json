    "question_count": 10
  },
  {
    "id": "g021",
    "level": 2,
    "level_label": "HSK2目安",
    "title_ja": "过：経験",
    "pattern": "主語＋動詞＋过＋目的語",
    "explanation_ja": "「〜したことがある」という経験です。否定は「没＋動詞＋过」。特定の一回の完了「了」とは焦点が違います。",
